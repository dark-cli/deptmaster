# Database
# Used by docker-compose.yml for PostgreSQL password
DB_PASSWORD=dev_password

# Server
# Port for the API server
PORT=8000
RUST_LOG=info

# EventStore
EVENTSTORE_URL=http://localhost:2113
EVENTSTORE_USERNAME=admin
EVENTSTORE_PASSWORD=changeit

# JWT (for API authentication)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=3600

# Rate Limiting (optional)
# Disabled by default (RATE_LIMIT_REQUESTS=0)
# Enable by setting RATE_LIMIT_REQUESTS to a positive number (e.g., 100)
# RATE_LIMIT_REQUESTS=0
# RATE_LIMIT_WINDOW=60

# Backup (optional)
BACKUP_ENCRYPTION_KEY=your-32-char-encryption-key
BACKUP_RETENTION_DAYS=30
