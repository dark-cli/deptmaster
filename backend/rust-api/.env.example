# Database Configuration
DATABASE_URL=postgresql://debt_tracker:dev_password@localhost:5432/debt_tracker

# Server Configuration
PORT=8000
ENVIRONMENT=development
SHOW_DEV_WARNINGS=false

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=3600

# CORS Configuration
ALLOWED_ORIGINS=*

# TLS Configuration (optional)
ENABLE_TLS=false
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Event Processing Configuration
EVENT_REBUILD_BATCH_SIZE=1000

# Snapshot Configuration
# Maximum number of snapshots to keep per wallet
# Higher values = more disk space but faster recovery from old events
# Lower values = less disk space but slower recovery from very old UNDO events
MAX_SNAPSHOTS_PER_WALLET=5

# How often to create snapshots (every N events)
# Lower values = more frequent snapshots, more disk space, faster recovery
# Higher values = less frequent snapshots, less disk space, slower recovery
SNAPSHOT_INTERVAL=10
